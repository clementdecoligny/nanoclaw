# Dependencies
node_modules/
.npm-cache/
# pnpm content-addressable store (created when running in sandbox mode)
.pnpm-store/
# Build output
dist/

# Python
__pycache__/
*.pyc
.venv/

# Local data & auth
store/
data/
logs/

# Groups - track knowledge/memory, exclude ephemeral runtime files
groups/*/logs/
groups/*/.heartbeat-bootstrapped
groups/*/HEARTBEAT.md
groups/*/attachments/
groups/alain/git-branch-hygiene.json
# Private per-group knowledge files. scripts/backup-db.sh runs `git add groups/`
# and pushes to origin nightly — these entries are the only thing keeping such
# files off the remote. The second-brain feature that created them was removed
# on 2026-10-20, but the rails stay: any group with skills:"all" could write
# here again, and groups/alain/wiki/ still holds clinical detail on disk.
#
# Globbed, not per-group: the wiki skill is mounted into every group with
# skills:"all" (all of them), so any group can grow a wiki/. A per-group entry
# would silently leave the next one exposed.
groups/*/wiki/
groups/*/sources/
*Zone.Identifier

# Secrets
*.keys.json
.env
.env*

# Temp files
.tmp-*

# Manual/nohup service state (generated by setup on WSL or hosts without a
# service manager; snapshot by update-nanoclaw, never source-controlled)
start-nanoclaw.sh
nanoclaw.pid

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

agents-sdk-docs
scripts/setup-v2-groups.ts
site/

# Garmin OAuth token stores (per-group) — never commit credentials/tokens
groups/*/.garminconnect/

# Per-group container config — a build artifact, regenerated from the
# container_configs table by materializeContainerJson() on every spawn.
# Never commit: it has historically carried resolved API tokens in MCP headers.
groups/*/container.json

# Runtime lock files (transient, not durable content)
.claude/scheduled_tasks.lock
.agents
AGENTS.md
# Skill payloads ship AGENTS.md as data.
!/.claude/skills/*/payload/**/AGENTS.md

# Internal working docs, never committed
docs/maintainer-guide.md
docs/drafts/
forks.md
.worktrees/

# Library templates copied in by setup or create_agent are install state.
/templates/*
!/templates/README.md

# Per-group memory (CLAUDE.local.md) must never be committed.
**/CLAUDE.local.md

# Generated by the old CLAUDE.md composer; no longer used
groups/*/.claude-fragments/
groups/*/.claude-shared.md
