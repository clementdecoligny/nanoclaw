# Dependencies
node_modules/
.npm-cache/
# pnpm content-addressable store (created when running in sandbox mode)
.pnpm-store/
# Build output
dist/

# Python
__pycache__/
*.pyc
.venv/

# Local data & auth
store/
data/
logs/

# Groups - track knowledge/memory, exclude ephemeral runtime files
groups/*/logs/
groups/*/.heartbeat-bootstrapped
groups/*/HEARTBEAT.md
groups/*/attachments/
groups/alain/git-branch-hygiene.json
*Zone.Identifier

# Secrets
*.keys.json
.env
.env*

# Temp files
.tmp-*

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

agents-sdk-docs
scripts/setup-v2-groups.ts
site/

# Garmin OAuth token stores (per-group) — never commit credentials/tokens
groups/*/.garminconnect/

# Runtime lock files (transient, not durable content)
.claude/scheduled_tasks.lock
